---
export interface Props {
  text?: string;
  color?: 'brand' | 'slate' | 'muted';
}

const { text, color = 'brand' } = Astro.props;

const colorStyles = {
  brand: 'text-brand-600 dark:text-brand-400',
  slate: 'text-slate-800 dark:text-slate-200',
  muted: 'text-slate-500 dark:text-slate-400',
};
---

<span class={`block text-[10px] font-black uppercase tracking-widest mb-1.5 ${colorStyles[color]}`}>
  <slot>{text}</slot>
</span>
