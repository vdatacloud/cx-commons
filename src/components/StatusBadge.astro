---
export interface Props {
  status: 'DRAFT' | 'FUNDED' | 'ACTIVE' | 'PROPOSED' | 'DISPUTED' | 'SETTLED' | 'FIAT_PENDING' | string;
  size?: 'sm' | 'md';
}

const { status, size = 'sm' } = Astro.props;

const statusUpper = status.toUpperCase();

const badgeStyles: Record<string, string> = {
  DRAFT: 'text-status-draft bg-status-draft/10 border-status-draft/20 dark:bg-status-draft/5 dark:border-status-draft/10',
  FUNDED: 'text-status-funded bg-status-funded/10 border-status-funded/20 dark:bg-status-funded/5 dark:border-status-funded/10',
  ACTIVE: 'text-status-active bg-status-active/10 border-status-active/20 dark:bg-status-active/5 dark:border-status-active/10',
  PROPOSED: 'text-status-proposed bg-status-proposed/10 border-status-proposed/20 dark:bg-status-proposed/5 dark:border-status-proposed/10',
  DISPUTED: 'text-status-disputed bg-status-disputed/10 border-status-disputed/20 dark:bg-status-disputed/5 dark:border-status-disputed/10',
  SETTLED: 'text-status-settled bg-status-settled/10 border-status-settled/20 dark:bg-status-settled/5 dark:border-status-settled/10',
  FIAT_PENDING: 'text-status-fiat-pending bg-status-fiat-pending/10 border-status-fiat-pending/20 dark:bg-status-fiat-pending/5 dark:border-status-fiat-pending/10',
};

const currentStyle = badgeStyles[statusUpper] || badgeStyles.DRAFT;

const sizeStyles = {
  sm: 'px-2.5 py-1 text-[10px] font-black tracking-widest',
  md: 'px-3 py-1.5 text-xs font-bold tracking-wider',
};
---

<span class={`inline-flex items-center justify-center rounded-full border uppercase transition-all duration-300 ${currentStyle} ${sizeStyles[size]}`}>
  <slot>{statusUpper.replace('_', ' ')}</slot>
</span>
