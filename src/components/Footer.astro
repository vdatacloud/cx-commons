---
import { getTranslator } from '../sdk/i18n';
import '../sdk/cx-messages';

export interface Props {
  showTelemetry?: boolean;
  locale?: string;
}
const { showTelemetry = false } = Astro.props;
const locale = Astro.props.locale ?? (Astro.locals as { locale?: string }).locale ?? Astro.currentLocale ?? 'en';
const t = getTranslator(locale);
const year = new Date().getFullYear();
---

<footer
	class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 p-6 transition-colors duration-300 print:hidden"
>
	<div
		class="container mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium text-slate-500 dark:text-slate-400"
	>
		<div class="flex items-center gap-3">
			<p>{t.t('cx.footer.copyright', { year: String(year) })}</p>
		</div>

		<div class="cx-caps flex items-center gap-5 uppercase tracking-wider font-black text-[10px]">
			<a href="/terms-and-conditions/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
				{t.t('cx.footer.terms')}
			</a>
			<a href="/privacy-policy/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
				{t.t('cx.footer.privacy')}
			</a>
			<button
				id="open-cookie-preferences"
				type="button"
				class="cx-caps hover:text-brand-600 dark:hover:text-brand-400 transition-colors border-none bg-transparent cursor-pointer uppercase tracking-wider font-black text-[10px] p-0"
			>
				{t.t('cx.footer.cookies')}
			</button>
		</div>
	</div>
</footer>

<script>
	document.getElementById('open-cookie-preferences')?.addEventListener('click', () => {
		(window as typeof window & { openCookiePreferences?: () => void }).openCookiePreferences?.();
	});
</script>
