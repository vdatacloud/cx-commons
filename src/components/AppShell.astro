---
// The page frame of a signed-in app: document head, sticky header with the
// app's mark and name, main column and footer. Shared by the escrow portal
// and the operator console (daml-escrow PLAN.md Phase 104.4); what an app
// puts in the header (navigation, sign-in, language) goes in its slots.
//
//   <AppShell title="Scheduler" brandName="Operator console">
//     <div slot="nav">…links…</div>
//     <PriceTicker slot="below-nav" />   (optional, under the header row)
//     …page…
//     <Footer slot="footer" />
//   </AppShell>
//
// A <script> or <style is:global> the app needs goes in its own layout, next
// to the AppShell, not inside it.

export interface Props {
  /** The document title. */
  title: string;
  /** Shown beside the mark. */
  brandName: string;
  /** Hover text for the name (e.g. the long product name). */
  brandTitle?: string;
  logoSrc?: string;
  logoAlt?: string;
  homeHref?: string;
  locale?: string;
}

const {
  title,
  brandName,
  brandTitle,
  logoSrc = '/favicon.svg',
  logoAlt = brandName,
  homeHref = '/',
} = Astro.props;
const locale = Astro.props.locale ?? (Astro.locals as { locale?: string }).locale ?? Astro.currentLocale ?? 'en';
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={logoSrc} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-300">
		<nav class="glass-nav p-4 sticky top-0 z-50 transition-colors duration-300 print:hidden">
			<div class="container mx-auto flex justify-between items-center gap-4">
				<div class="flex items-center space-x-3">
					<a href={homeHref} class="flex items-center space-x-3 group">
						<div class="w-10 h-10 bg-brand-500/10 rounded-2xl flex items-center justify-center text-brand-500 shadow-sm border border-brand-500/20 group-hover:scale-105 transition-transform duration-300">
							<img src={logoSrc} alt={logoAlt} class="w-7 h-7" />
						</div>
						<h1 class="cx-caps text-sm font-black tracking-tight text-slate-800 dark:text-white uppercase" title={brandTitle}>{brandName}</h1>
					</a>
				</div>
				<slot name="nav" />
			</div>
			<slot name="below-nav" />
		</nav>

		<main class="container mx-auto p-6 flex-grow print:p-0 print:max-w-none">
			<slot />
		</main>
		<div class="print:hidden">
			<slot name="footer" />
		</div>
	</body>
</html>
