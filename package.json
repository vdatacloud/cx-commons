  },
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "astro": "^7.1.1",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "design-system",
    "tailwindcss",
    "cx-commons"
  ],
