{
  "name": "@vdatacloud/cx-commons",
  "version": "0.1.3",
  "description": "Product CX Commons - Shared design system, UI components, and Astro integration for Data Cloud web applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdatacloud/cx-commons.git"
  },
  "homepage": "https://github.com/vdatacloud/cx-commons#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts"
    },
    "./styles/global.css": "./src/styles/global.css",
    "./components/*": "./src/components/*.astro",
    "./sdk/*": "./src/sdk/*.ts",
    "./schema/api-error.json": "./src/schema/api-error.schema.json"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "sync:api-error-fixtures": "scripts/sync-api-error-fixtures.sh"
  },
  "peerDependencies": {
    "@tailwindcss/typography": "^0.5.0",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.3.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "design-system",
    "tailwindcss",
    "cx-commons"
  ],
  "author": "Data Cloud LLC",
  "license": "MIT"
}
